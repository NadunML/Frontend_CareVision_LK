# ==============================================================
# CareVision LK — Frontend Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file. It is listed in .gitignore.
# ==============================================================

# Backend Flask API base URL
VITE_API_URL=http://localhost:5000

# Firebase Project Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Microsoft Azure AD — tenant ID for university SSO
VITE_MICROSOFT_TENANT_ID=your-azure-tenant-id

# Comma-separated list of authorised admin emails (User Management tab)
VITE_AUTHORIZED_ADMIN_EMAILS=admin1@example.com,admin2@example.com
